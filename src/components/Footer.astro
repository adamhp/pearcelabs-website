---
import Wordmark from "./Wordmark.astro";

const links = [
  { label: "Contact", href: "/contact" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
  { label: "Support", href: "/support" },
];
---

<footer class="pt-4 pb-32">
  <div class="grid h-8 grid-cols-3 items-center">
    <Wordmark />
    <div
      class="text-center font-mono text-xs tracking-widest text-stone-500 uppercase"
    >
      Falls Church, VA
    </div>
    <div class="justify-self-end font-mono text-xs text-stone-500 uppercase">
      © 2026 Pearce Labs, LLC.
    </div>
  </div>
  <hr class="my-2 border-stone-500" aria-hidden="true" />
  <div
    class="flex h-6 items-center justify-center gap-4 font-mono text-xs tracking-widest"
  >
    {
      links.map((link, i) => (
        <>
          {i > 0 && <span class="text-accent">·</span>}
          <a
            href={link.href}
            class="text-stone-500 uppercase transition-colors duration-200 hover:text-accent"
          >
            {link.label}
          </a>
        </>
      ))
    }
  </div>
</footer>
