---
import Wordmark from "./Wordmark.astro";

const links = [
  { label: "Contact", href: "/contact" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
  { label: "Support", href: "/support" },
];
---

<footer class="pt-16 pb-32">
  <div class="h-8 flex flex-row items-center w-full">
    <div
      class="hidden mx-auto font-mono text-xs text-stone-600 uppercase sm:block">
      © 2026 Pearce Labs, LLC.
    </div>
  </div>
  <hr class="my-2 border-stone-500" aria-hidden="true" />
  <div
    class="flex h-6 items-center justify-between gap-4 font-mono text-xs tracking-widest sm:justify-center">
    {
      links.map((link, i) => (
        <>
          {i > 0 && <span class="mb-0.5 text-xl leading-0 text-accent" aria-hidden="true">·</span>}
          <a
            href={link.href}
            class="text-stone-600 uppercase transition-colors duration-200 hover:text-accent">
            {link.label}
          </a>
        </>
      ))
    }
  </div>
  <div
    class="mt-12 w-full justify-center text-center font-mono text-xs text-stone-600 uppercase sm:hidden">
    © 2026 Pearce Labs, LLC.
  </div>
</footer>
