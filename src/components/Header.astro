---
import Wordmark from "../components/Wordmark.astro";
import { services } from "../constants";
const { pathname } = Astro.url;
---

<header class="py-4">
  <!-- Mobile: simplified two-column header -->
  <div class="flex h-8 items-center justify-between sm:hidden">
    <Wordmark />
    {
      pathname !== "/" ? (
        <nav aria-label="Site navigation">
          <a
            class="font-mono text-xs tracking-widest text-stone-600 uppercase transition-colors duration-200 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            href="/">
            ← Home
          </a>
        </nav>
      ) : (
        <span class="font-mono text-xs tracking-widest text-stone-600 uppercase">
          Est. 2025
        </span>
      )
    }
  </div>

  <!-- Desktop: full three-column header -->
  <div class="hidden h-8 grid-cols-3 items-center sm:grid">
    <Wordmark />
    <div
      class="text-center font-mono text-xs tracking-widest text-stone-600 uppercase">
      Falls Church, VA
    </div>
    {
      pathname !== "/" ? (
        <nav aria-label="Site navigation" class="flex flex-row items-center justify-self-end">
          <a
            class="font-mono text-xs tracking-widest text-stone-600 uppercase transition-colors duration-200 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            href="/">
            ← Home
          </a>
        </nav>
      ) : (
        <div class="justify-self-end font-mono text-xs tracking-widest text-stone-600 uppercase">
          Est. 2025
        </div>
      )
    }
  </div>

  <hr class="my-2 border-stone-500" aria-hidden="true" />
  <div
    class="flex h-6 w-full items-center justify-center gap-1.5 overflow-hidden font-mono text-xs tracking-normal text-stone-600 uppercase sm:gap-4 sm:tracking-widest">
    {
      services.map((svc, i) => (
        <>
          {i > 0 && <div class="mb-0.5 text-xl leading-0 text-accent" aria-hidden="true"> · </div>}
          <div>{svc.abbrev}</div>
        </>
      ))
    }
  </div>
</header>
