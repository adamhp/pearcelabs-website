---
import Wordmark from "../components/Wordmark.astro";
import { services } from "../constants";
const { pathname } = Astro.url;
---

<header class="hidden py-4 sm:block">
  <div class="grid h-8 grid-cols-3 items-baseline">
    <Wordmark />
    <div
      class="hidden text-center font-mono text-xs tracking-widest text-stone-600 uppercase sm:block">
      Falls Church, VA
    </div>
    {
      pathname !== "/" ? (
        <div class="flex flex-row items-center justify-self-end">
          <div class="font-mono text-xs tracking-widest text-stone-600 uppercase">
            <a
              class="transition-colors duration-200 hover:text-accent"
              href="/">
              ← Home
            </a>
          </div>
        </div>
      ) : (
        <div class="justify-self-end font-mono text-xs tracking-widest text-stone-600 uppercase">
          Est. 2025
        </div>
      )
    }
  </div>
  <hr class="my-2 border-stone-500" />
  <div
    class="flex h-6 w-full items-center justify-center gap-4 overflow-hidden font-mono text-xs tracking-normal text-stone-600 uppercase sm:tracking-widest">
    {
      services.map((svc, i) => (
        <>
          {i > 0 && <div class="mb-0.5 text-xl leading-0 text-accent"> · </div>}
          <div>{svc.abbrev}</div>
        </>
      ))
    }
  </div>
</header>
