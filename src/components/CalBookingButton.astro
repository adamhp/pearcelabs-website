<!-- Cal element-click embed code — lazy-loaded on first click -->
<script type="text/javascript">
  (function () {
    var CAL_URL = "https://app.cal.com/embed/embed.js";
    var calLoading = false;
    var calLoaded = false;

    function initCal() {
      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, CAL_URL, "init");

      Cal("init", "intro", { origin: "https://app.cal.com" });
      Cal.ns.intro("ui", {
        cssVarsPerTheme: {
          light: { "cal-brand": "#171717" },
          dark: { "cal-brand": "#f5f5f4" },
        },
        hideEventTypeDetails: false,
        layout: "month_view",
      });
    }

    document.addEventListener(
      "click",
      function (e) {
        var trigger = e.target.closest("[data-cal-link]");
        if (!trigger) return;
        if (calLoaded) return;
        if (calLoading) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }

        e.preventDefault();
        e.stopPropagation();
        calLoading = true;

        initCal();

        var script = document.querySelector('script[src="' + CAL_URL + '"]');
        if (script) {
          script.addEventListener("load", function () {
            calLoaded = true;
            setTimeout(function () {
              trigger.click();
            }, 0);
          });
        } else {
          calLoaded = true;
        }
      },
      true,
    );
  })();
</script>
