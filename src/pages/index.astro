---
import Footer from "../components/Footer.astro";
import Wordmark from "../components/Wordmark.astro";
import Layout from "../layouts/Layout.astro";

const services = [
  {
    index: "01",
    abbrev: "Software",
    name: "Software Development",
    desc: "Custom software designed around your specific requirements, built from architecture through deployment with long-term maintainability in mind.",
  },
  {
    index: "02",
    abbrev: "AI",
    name: "AI Implementation",
    desc: "AI integrations that automate repetitive tasks and surface useful information, saving your team time and improving how you operate.",
  },
  {
    index: "03",
    abbrev: "Data",
    name: "Data Engineering & Visualization",
    desc: "Data pipeline architecture and dashboard design that makes your data reliable, accessible, and useful for decision-making.",
  },
  {
    index: "04",
    abbrev: "Web",
    name: "Web and Presence",
    desc: "Fast, polished websites that reflect the quality of your work, built with performance as a core requirement.",
  },
  {
    index: "05",
    abbrev: "Consulting",
    name: "Technology Consulting",
    desc: "Technical guidance from practitioners who have built production systems. Useful for vendor evaluation, stack planning, or reviewing technical decisions before you commit.",
  },
];

const inputClass =
  "bg-transparent border-0 border-b border-stone-500 py-2 font-body text-sm text-ink outline-none transition-colors duration-200 focus:border-accent appearance-none rounded-none placeholder:text-stone-500 w-full";

const labelClass = "font-mono text-xs tracking-widest text-stone-500 uppercase";
---

<Layout>
  <!-- HEADER -->
  <header class="py-4">
    <div class="flex h-6 items-center justify-between">
      <Wordmark />
      <div
        class="min-w-32 font-mono text-xs tracking-widest text-stone-500 uppercase"
      >
        Falls Church, VA
      </div>
      <div
        class="min-w-32 text-right font-mono text-xs tracking-widest text-stone-500 uppercase"
      >
        Est. 2025
      </div>
    </div>
    <hr class="my-2 border-stone-500" />
    <div
      class="flex h-6 items-center justify-center font-mono text-xs tracking-widest text-stone-500 uppercase"
    >
      <div class="mx-auto flex items-center justify-between gap-4">
        {
          services.map((svc, i) => (
            <>
              {i > 0 && <div class="text-accent"> · </div>}
              <div>{svc.abbrev}</div>
            </>
          ))
        }
      </div>
    </div>
  </header>
  <!-- HERO -->
  <section class="pt-10 pb-8 sm:pt-20 sm:pb-16">
    <h1
      class="hero-name js-hero-name py-5 text-center font-body text-7xl leading-none font-black tracking-tight text-ink sm:py-10"
    >
      pearce <span class="mx-2 text-accent">/</span> labs
    </h1>
    <div
      class="grid grid-cols-1 gap-6 pt-6 sm:grid-cols-[1fr_auto] sm:items-end sm:pt-10"
    >
      <div
        class="hero-tagline js-tagline max-w-sm font-body text-xl leading-snug"
      >
        Full-stack thinking. <em>Full-scope execution.</em>
      </div>
      <a href="#contact" class="btn hero-cta js-hero-cta"
        >Get in touch <span class="arr">→</span></a
      >
    </div>
  </section>
  <!-- SERVICES -->
  <section class="py-12 sm:py-24" id="services">
    <div class="mb-2.5 flex items-baseline justify-between gap-4">
      <h2
        class="font-body text-3xl leading-none font-black tracking-tight uppercase"
      >
        Services
      </h2>
      <span class="shrink-0 font-mono text-xs tracking-widest text-stone-500"
        >01 / 02</span
      >
    </div>
    <span class="rule js-rule"></span>
    <div class="mt-6 divide-y divide-stone-500 *:py-12 sm:mt-10">
      {
        services.map((svc) => (
          <div class="svc js-svc grid grid-cols-1 gap-x-6 sm:grid-cols-[5fr_7fr] sm:items-start">
            <div class="relative">
              <span class="self-top absolute -top-4 mb-1.5 block font-mono text-xs tracking-widest text-accent">
                {svc.index}
              </span>
              <h3
                class="self-top font-body text-xl leading-tight font-bold tracking-tight"
                set:html={svc.name}
              />
            </div>
            <p class="pt-2 text-sm leading-relaxed sm:pt-0.5">{svc.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="pt-12 pb-32" id="contact">
    <div class="mb-2.5 flex items-baseline justify-between gap-4">
      <h2
        class="contact-hed js-contact-hed font-body text-3xl leading-none font-black tracking-tight uppercase"
      >
        Let's work together
      </h2>
      <span class="shrink-0 font-mono text-xs tracking-widest text-stone-500"
        >02 / 02</span
      >
    </div>
    <span class="rule js-rule"></span>
    <!-- CONTACT -->
    <div
      class="contact-body js-contact-body mt-6 grid grid-cols-1 gap-8 sm:gap-16 md:grid-cols-[4fr_6fr]"
    >
      <div>
        <p class="text-base leading-relaxed">
          Based in Falls Church, VA. Available to businesses across the DC metro
          area and beyond.
        </p>
        <div class="mt-7">
          <span class={`${labelClass} mb-1.5 block`}>Email</span>
          <a
            href="mailto:hello@pearcelabs.com"
            class="border-b border-stone-500 pb-0.5 font-mono text-sm text-ink no-underline transition-colors duration-200 hover:border-accent hover:text-accent sm:text-base"
          >
            email@pearcelabs.com
          </a>
        </div>
      </div>

      <form
        class="relative flex flex-col gap-4"
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>
        <div class="js-field flex flex-col gap-1.5">
          <label class={labelClass} for="f-name">Name</label>
          <input
            class={inputClass}
            type="text"
            id="f-name"
            name="name"
            placeholder="Your name"
            required
            autocomplete="name"
          />
        </div>
        <div class="js-field flex flex-col gap-1.5">
          <label class={labelClass} for="f-email">Email</label>
          <input
            class={inputClass}
            type="email"
            id="f-email"
            name="email"
            placeholder="your@email.com"
            required
            autocomplete="email"
          />
        </div>
        <div class="js-field flex flex-col gap-1.5">
          <label class={labelClass} for="f-msg">Message</label>
          <textarea
            class={`${inputClass} resize-none min-h-20`}
            id="f-msg"
            name="message"
            placeholder="Tell me what you're working on"
            rows={3}
            required></textarea>
        </div>
        <button type="submit" class="btn mt-1.5 self-start">
          Send message <span class="arr">→</span>
        </button>
        <div
          class="pointer-events-none absolute inset-0 flex items-center font-mono text-sm tracking-wider text-ink opacity-0 transition-opacity duration-500"
          id="form-success"
        >
          Message received — we'll be in touch shortly.
        </div>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <Footer />

  <script>
    // Rules animate in on load
    document.querySelectorAll<HTMLElement>(".js-rule").forEach((r, i) => {
      setTimeout(() => r.classList.add("rule--on"), i * 120);
    });

    (
      [
        [".js-hero-name", "hero-name--on", 80],
        [".js-tagline", "hero-tagline--on", 420],
        [".js-hero-cta", "hero-cta--on", 620],
      ] as [string, string, number][]
    ).forEach(([sel, cls, delay]) => {
      setTimeout(() => document.querySelector(sel)?.classList.add(cls), delay);
    });

    // Scroll-triggered reveals
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const target = e.target as HTMLElement;
          target.classList.add(target.dataset.on!);
          io.unobserve(target);
        });
      },
      { threshold: 0.12 },
    );

    document.querySelectorAll<HTMLElement>(".js-svc").forEach((el, i) => {
      el.style.transitionDelay = `${i * 0.09}s`;
      el.dataset.on = "svc--on";
      io.observe(el);
    });

    (
      [
        [".js-contact-hed", "contact-hed--on"],
        [".js-contact-body", "contact-body--on"],
      ] as [string, string][]
    ).forEach(([sel, cls]) => {
      const el = document.querySelector<HTMLElement>(sel);
      if (el) {
        el.dataset.on = cls;
        io.observe(el);
      }
    });

    // Contact form
    document
      .getElementById("contact-form")
      ?.addEventListener("submit", async function (e) {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement;
        const btn = form.querySelector<HTMLButtonElement>(".btn")!;
        btn.textContent = "Sending…";
        btn.style.pointerEvents = "none";
        try {
          await fetch("/", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: new URLSearchParams(
              new FormData(form) as unknown as Record<string, string>,
            ).toString(),
          });
          btn.textContent = "Sent ✓";
          btn.classList.add("btn--sent");
          const successEl = document.getElementById("form-success");
          if (successEl) {
            successEl.style.opacity = "1";
            successEl.style.pointerEvents = "auto";
          }
          form
            .querySelectorAll<HTMLElement>(".js-field")
            .forEach((f) => (f.style.visibility = "hidden"));
        } catch {
          btn.textContent = "Send message";
          btn.style.pointerEvents = "";
        }
      });
  </script>
</Layout>
