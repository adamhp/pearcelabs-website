---
import Button from "../components/Button.astro";
import CalBookingButton from "../components/CalBookingButton.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { services, tagline1, tagline2 } from "../constants";

import Layout from "../layouts/Layout.astro";
---

<Layout title="Pearce Labs | Software Development & Tech Consulting">
  <!-- HEADER -->
  <Header />
  <main>
    <!-- HERO -->
    <section class="py-12">
      <h1
        id="hero"
        class="py-5 text-center font-body text-5xl leading-none font-black tracking-tighter text-ink opacity-0 transition-[opacity,transform] duration-[850ms] ease-out data-[on]:opacity-100 sm:py-10 sm:text-7xl">
        pearce <span class="mx-2 text-accent">/</span> labs
      </h1>
      <div class="mx-auto flex w-full max-w-xs flex-col sm:max-w-sm">
        <div
          id="tagline-1"
          class="max-w-sm translate-y-4 font-body text-xl leading-snug opacity-0 transition-[opacity,transform] delay-250 duration-1000 ease-out data-[on]:opacity-100">
          {tagline1}
        </div>
        <div
          id="tagline-2"
          class="mt-4 max-w-sm translate-y-4 self-end font-body text-xl leading-snug opacity-0 transition-[opacity,transform] delay-500 duration-1000 ease-out data-[on]:opacity-100">
          <em>{tagline2}</em>
        </div>
        <div
          id="hero-cta"
          class="mx-auto mt-12 opacity-0 transition-[opacity,transform] delay-750 duration-1000 ease-out data-[on]:opacity-100">
          <Button href="/contact" class="mt-3">Get in touch</Button>
        </div>
      </div>
    </section>
    <!-- SERVICES -->
    <section class="py-12 sm:py-24" id="services">
      <div class="mb-2.5 flex items-baseline justify-between gap-4">
        <h2
          class="font-body text-3xl leading-none font-black tracking-tight uppercase">
          Services
        </h2>
        <span class="shrink-0 font-mono text-xs tracking-widest text-stone-600"
          >01 / 02</span
        >
      </div>
      <span
        class="js-rule block h-px w-0 bg-stone-500 transition-[width] duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] data-[on]:w-full"
      ></span>
      <div class="mt-6 divide-y divide-stone-500 *:py-12 sm:mt-10">
        {
          services.map((svc) => (
            <div class="js-svc grid translate-y-5 grid-cols-1 gap-x-6 opacity-0 transition-[opacity,transform] duration-500 data-[on]:translate-y-0 data-[on]:opacity-100 sm:grid-cols-[5fr_7fr] sm:items-start">
              <div class="relative">
                <span class="self-top absolute -top-4 mb-1.5 block font-mono text-xs tracking-widest text-accent">
                  {svc.index}
                </span>
                <h3
                  class="self-top font-body text-xl leading-tight font-bold tracking-tight"
                  set:html={svc.name}
                />
              </div>
              <p class="pt-2 text-base leading-relaxed sm:pt-0.5">{svc.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <ContactSection sectionLabel="02 / 02" />
  </main>

  <!-- FOOTER -->
  <Footer />
  <CalBookingButton />
  <script>
    // Load-triggered reveals
    document.querySelectorAll<HTMLElement>(".js-rule").forEach((r, i) => {
      setTimeout(() => {
        r.dataset.on = "";
      }, i * 120);
    });

    (
      [
        ["#hero", 100],
        ["#tagline-1", 300],
        ["#tagline-2", 500],
        ["#hero-cta", 750],
      ] as [string, number][]
    ).forEach(([sel, delay]) => {
      setTimeout(() => {
        const el = document.querySelector<HTMLElement>(sel);
        if (el) el.dataset.on = "";
      }, delay);
    });

    // Hero CTA tracking
    document
      .querySelector<HTMLAnchorElement>("#hero-cta a")
      ?.addEventListener("click", () => {
        window.posthog?.capture("hero_cta_clicked");
      });

    // Scroll-triggered reveals
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          (e.target as HTMLElement).dataset.on = "";
          io.unobserve(e.target);
        });
      },
      { threshold: 0.12 },
    );

    document.querySelectorAll<HTMLElement>(".js-svc").forEach((el, i) => {
      el.style.transitionDelay = `${i * 0.09}s`;
      io.observe(el);
    });
  </script>
</Layout>
