---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Wordmark from "../components/Wordmark.astro";
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---

<Layout title={title} description={description} robots={robots}>
  <Header />
  <main class="prose mx-auto max-w-[65ch] pt-12 pb-24">
    <slot />
  </main>
  <Footer />
</Layout>
